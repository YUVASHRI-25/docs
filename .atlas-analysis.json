  "keyFeatures": [
    "ATS Score Analysis — measures how well a resume aligns with applicant tracking systems",
    "Resume Parsing — extracts education, skills, certifications, and experience from PDF/DOCX",
    "Coding Profile Analysis — fetches LeetCode, GitHub, and CodeChef activity metrics",
    "AI Role Prediction — uses HuggingFace + keyword heuristics to recommend suitable fresher roles",
    "Career Guidance — LLM-generated step-by-step improvement tips and role roadmaps",
    "AI Chat Assistant — resume-aware Q&A powered by OpenRouter GPT models",
    "Trainer Resume Filtering — filter student resumes by CGPA, skills, degree, ATS score with SSE streaming",
    "Top-N AI Resume Ranking — GROQ LLaMA 4 extraction + OpenRouter scoring to surface best candidates",
    "Skillset Management — upload and manage company-specific skill requirements via Excel files",
    "Role-based Access Control — separate dashboards for admin (HR), trainer, and user (job seeker)",
    "Google OAuth — sign-in restricted to institutional email domain",
    "Portfolio Generation — auto-generate a structured portfolio from resume data"
  ],
